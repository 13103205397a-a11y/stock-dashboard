{
  "version": 3,
  "description": "活跃模块刷新计划。Mac App 和命令行统一读取此文件。",
  "steps": [
    {
      "name": "抓日K(TickFlow免费档)",
      "command": ["python3", "scripts/fetch_klines_tf.py"],
      "timeout": 300,
      "required": true
    },
    {
      "name": "算技术信号",
      "command": ["node", "scripts/fetch_signals.js"],
      "timeout": 300,
      "required": true
    },
    {
      "name": "抓新闻(东方财富)",
      "command": ["python3", "scripts/fetch_news.py"],
      "timeout": 300,
      "required": false
    },
    {
      "name": "补资金/研报/估值",
      "command": ["python3", "scripts/fetch_enhanced.py"],
      "timeout": 300,
      "required": false
    },
    {
      "name": "全市场异动",
      "command": ["python3", "scripts/fetch_market.py"],
      "timeout": 300,
      "required": true
    },
    {
      "name": "清理AI公开内容",
      "command": ["python3", "scripts/sanitize_ai_content.py"],
      "timeout": 60,
      "required": true
    },
    {
      "name": "校验公开数据契约",
      "command": ["node", "scripts/validate_data.js"],
      "timeout": 60,
      "required": true
    },
    {
      "name": "校验数据新鲜度",
      "command": ["node", "scripts/check_freshness.js", "--strict"],
      "timeout": 60,
      "required": true
    }
  ]
}
